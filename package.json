{
  "name": "tend",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.2",
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "expo": "~57.0.15",
    "expo-application": "~57.0.2",
    "expo-contacts": "~57.0.4",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.5",
    "expo-font": "~57.0.1",
    "expo-iap": "4.3.1",
    "expo-mail-composer": "~57.0.1",
    "expo-notifications": "~57.0.13",
    "expo-sharing": "~57.0.14",
    "expo-splash-screen": "~57.0.7",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.16",
    "lucide-react-native": "1.21.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/jest-runner": "^9.6.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "fast-check": "^3.23.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.2",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --port 8408",
    "android": "expo run:android --port 8408",
    "ios": "LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 expo run:ios --port 8408",
    "web": "expo start --web",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg))"
    ],
    "reporters": [
      "default",
      "<rootDir>/qa/defect-reporter.cjs"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/qa/quarantine.setup.cjs"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/qa/known-bad/",
      "<rootDir>/.stryker-tmp/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.stryker-tmp/"
    ],
    "testTimeout": 30000
  }
}
